{
  "name": "@global-packages/mcp-kit",
  "version": "1.0.0",
  "description": "Universal MCP Configuration CLI — auto-detect, configure and manage MCP servers across Azure, Confluence, MSSQL, Playwright and more. Works on Windows, macOS and Linux.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-kit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build && node dist/postinstall.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage .nyc_output"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vscode",
    "cli",
    "azure",
    "confluence",
    "mssql",
    "playwright",
    "devtools",
    "configuration",
    "automation",
    "ai-tools"
  ],
  "author": "global-packages",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.0",
    "inquirer": "^9.2.0",
    "keytar": "^7.9.0",
    "mcp-kit": "^1.2.8",
    "node-machine-id": "^1.1.12",
    "ora": "^8.0.0",
    "semver": "^7.6.0",
    "table": "^6.8.0",
    "update-notifier": "^7.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ]
}
